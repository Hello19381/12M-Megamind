// Red side autonomous
void red_side() {
    chassis.setPose(0, -60, 0);

    chassis.moveToPoint(0, -45, 1000);
    chassis.moveToPoint(0, -60, 1000, {.forwards = false});
    chassis.moveToPoint(0, -45, 1000);

    chassis.moveToPoint(19, -48, 3000, {.forwards = false});
    chassis.moveToPoint(35, -48, 1800);

    // Side route turns in the opposite direction
    chassis.turnToHeading(chassis.getPose().theta - 85, 1000);
    chassis.waitUntilDone();

    lemlib::Pose p = chassis.getPose();
    float h = p.theta * M_PI / 180.0;

    chassis.moveToPoint(
        p.x - 30 * sin(h),
        p.y - 30 * cos(h),
        2000,
        {.forwards = false, .maxSpeed = 60}
    );

    cascades.move_absolute(cascade_score, 1000);
    wrist.move_absolute(wrist_score, 1000);
    intake_and_claw.move_absolute(claw_drop, 1000);
}

// Blue side autonomous
void blue_side() {
    chassis.setPose(0, -60, 0);

    // Hit the toggle once; skip the second back-and-forward sequence
    chassis.moveToPoint(0, -45, 1000);

    chassis.moveToPoint(19, -48, 3000, {.forwards = false});
    chassis.moveToPoint(35, -48, 1800);

    // Side route turns in the opposite direction
    chassis.turnToHeading(chassis.getPose().theta - 85, 1000);
    chassis.waitUntilDone();

    lemlib::Pose p = chassis.getPose();
    float h = p.theta * M_PI / 180.0;

    chassis.moveToPoint(
        p.x - 30 * sin(h),
        p.y - 30 * cos(h),
        2000,
        {.forwards = false, .maxSpeed = 60}
    );

    cascades.move_absolute(cascade_score, 1000);
    wrist.move_absolute(wrist_score, 1000);
    intake_and_claw.move_absolute(claw_drop, 1000);
}

void initialize() {
    pros::lcd::initialize();

    chassis.calibrate();

    left_motors.set_brake_mode(pros::E_MOTOR_BRAKE_HOLD);
    right_motors.set_brake_mode(pros::E_MOTOR_BRAKE_HOLD);
    cascades.set_brake_mode(pros::E_MOTOR_BRAKE_HOLD);
    wrist.set_brake_mode(pros::E_MOTOR_BRAKE_HOLD);

    wrist.set_encoder_units(pros::E_MOTOR_ENCODER_DEGREES);

    pros::lcd::register_btn0_cb(select_previous);
    pros::lcd::register_btn2_cb(select_next);

    display_auton();
}

void disabled() {}

void competition_initialize() {
    display_auton();
}

void autonomous() {
    switch (selected_auton) {
        case 0:
            red_back();
            break;

        case 1:
            blue_back();
            break;

        case 2:
            red_side();
            break;

        case 3:
            blue_side();
            break;
    }
}

void opcontrol() {
    pros::Controller controller(pros::E_CONTROLLER_MASTER);

    bool intakeOn = false;
    bool intakeOut = false;

    const double MAX_POS = 900.0;
    const double MIN_SPEED = 0.1;

    wrist.set_brake_mode(pros::E_MOTOR_BRAKE_HOLD);
    wrist.tare_position();

    while (true) {
        // Drivetrain
        int leftY = controller.get_analog(
            pros::E_CONTROLLER_ANALOG_LEFT_Y
        );

        int rightX = controller.get_analog(
            pros::E_CONTROLLER_ANALOG_RIGHT_X
        );

        chassis.arcade(leftY, rightX);

        // Wrist control
        double t = std::clamp(
            wrist.get_position() / MAX_POS,
            0.0,
            1.0
        );

        double scale = 0.5 - t * (0.5 - MIN_SPEED);

        if (controller.get_digital(pros::E_CONTROLLER_DIGITAL_DOWN)) {
            wrist.move(127 * scale);
        } else if (controller.get_digital(pros::E_CONTROLLER_DIGITAL_B)) {
            wrist.move(-80 * scale);
        } else {
            wrist.brake();
        }

        // Cascade control
        if (controller.get_digital(pros::E_CONTROLLER_DIGITAL_L1)) {
            cascades.move(-127);
        } else if (controller.get_digital(pros::E_CONTROLLER_DIGITAL_L2)) {
            cascades.move(100);
        } else {
            cascades.move(0);
        }

        // Toggle intake with R1 and outtake with R2
        if (controller.get_digital_new_press(
                pros::E_CONTROLLER_DIGITAL_R1)) {
            intakeOn = !intakeOn;
            intakeOut = false;
        }

        if (controller.get_digital_new_press(
                pros::E_CONTROLLER_DIGITAL_R2)) {
            intakeOut = !intakeOut;
            intakeOn = false;
        }

        if (intakeOn) {
            intake_and_claw.move(127);
        } else if (intakeOut) {
            intake_and_claw.move(-127);
        } else {
            intake_and_claw.move(0);
        }

        pros::delay(20);
    }
}
