#include "main.h"
#include "lemlib/api.hpp"
#include "api.h"
#include "pros/adi.hpp"
#include "pros/misc.h"

#include <algorithm>
#include <cmath>

// Motors
pros::MotorGroup left_motors({-1, -2}, pros::MotorGears::blue);
pros::MotorGroup right_motors({3, 4}, pros::MotorGears::blue);

pros::MotorGroup cascades({19, -20}, pros::MotorGears::blue);
pros::Motor wrist(11, pros::MotorGears::blue);
pros::MotorGroup intake_and_claw({5, 7}, pros::MotorGears::blue);

// Sensors
// pros::Imu imu(15);

lemlib::OdomSensors sensors(nullptr, nullptr, nullptr, nullptr, nullptr);

// Drivetrain settings
lemlib::Drivetrain drivetrain(
    &left_motors,
    &right_motors,
    10,
    lemlib::Omniwheel::NEW_275,
    600,
    2
);

lemlib::ControllerSettings lateral_controller(
    10, 0, 3, 3, 1, 100, 3, 500, 20
);

lemlib::ControllerSettings angular_controller(
    2, 0, 10, 3, 1, 100, 3, 500, 0
);

lemlib::Chassis chassis(
    drivetrain,
    lateral_controller,
    angular_controller,
    sensors
);

// Mechanism positions
int wrist_start = 0;
int wrist_pickup = 800;
int wrist_score = 1200;

int cascade_start = 0;
int cascade_pickup = 80;
int cascade_score = 80;

int claw_pickup = 800;
int claw_drop = 0;

// Autonomous selector
int selected_auton = 0;

const char* auton_names[] = {
    "Red Back",
    "Blue Back",
    "Red Side",
    "Blue Side"
};

void display_auton() {
    pros::lcd::print(0, "Select Autonomous:");
    pros::lcd::print(1, "Auton: %s", auton_names[selected_auton]);
    pros::lcd::print(2, "< Previous | Next >");
}

void select_previous() {
    selected_auton = (selected_auton + 3) % 4;
    display_auton();
}

void select_next() {
    selected_auton = (selected_auton + 1) % 4;
    display_auton();
}

// Red back autonomous
void red_back() {
    chassis.setPose(0, -60, 0);

    // Hit the toggle, back up, then hit it again
    chassis.moveToPoint(0, -45, 1000);
    chassis.moveToPoint(0, -60, 1000, {.forwards = false});
    chassis.moveToPoint(0, -45, 1000);

    // Go to the alliance goal
    chassis.moveToPoint(19, -48, 3000, {.forwards = false});
    chassis.moveToPoint(35, -48, 1800);

    // Turn toward the next target
    chassis.turnToHeading(chassis.getPose().theta + 85, 1000);
    chassis.waitUntilDone();

    // Drive backward relative to the robot's current heading
    lemlib::Pose p = chassis.getPose();
    float h = p.theta * M_PI / 180.0;

    chassis.moveToPoint(
        p.x - 30 * sin(h),
        p.y - 30 * cos(h),
        2000,
        {.forwards = false, .maxSpeed = 60}
    );

    // Score at the alliance goal
    cascades.move_absolute(cascade_score, 1000);
    wrist.move_absolute(wrist_score, 1000);
    intake_and_claw.move_absolute(claw_drop, 1000);
}

// Blue back autonomous
void blue_back() {
    chassis.setPose(0, -60, 0);

    // Hit the toggle once; skip the second back-and-forward sequence
    chassis.moveToPoint(0, -45, 1000);

    // Go to the alliance goal
    chassis.moveToPoint(19, -48, 3000, {.forwards = false});
    chassis.moveToPoint(35, -48, 1800);

    // Turn toward the next target
    chassis.turnToHeading(chassis.getPose().theta + 85, 1000);
    chassis.waitUntilDone();

    lemlib::Pose p = chassis.getPose();
    float h = p.theta * M_PI / 180.0;

    chassis.moveToPoint(
        p.x - 30 * sin(h),
        p.y - 30 * cos(h),
        2000,
        {.forwards = false, .maxSpeed = 60}
    );

    // Score at the alliance goal
    cascades.move_absolute(cascade_score, 1000);
    wrist.move_absolute(wrist_score, 1000);
