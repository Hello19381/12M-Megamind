/**
 * Runs the operator control code. This function will be started in its own task
 * with the default priority and stack size whenever the robot is enabled via
 * the Field Management System or the VEX Competition Switch in the operator
 * control mode.
 *
 * If no competition control is connected, this function will run immediately
 * following initialize().
 *
 * If the robot is disabled or communications is lost, the
 * operator control task will be stopped. Re-enabling the robot will restart the
 * task, not resume it from where it left off.
 */
void opcontrol() {
    pros::Controller controller(pros::E_CONTROLLER_MASTER);
    bool intakeOn = false; // tracks whether the intake is toggled on
    bool intakeOut = false; // tracks whether the outtake is toggled on
    bool wasDownPressed = false; // tracks button state for release detection 
    bool wasBPressed = false; // tracks button state for release detection
    int wristStage = 0; // 0 = down, 1 = up, 2 = further up
    while (true) {
        // drivetrain — split arcade
        int leftY = controller.get_analog(pros::E_CONTROLLER_ANALOG_LEFT_Y);
        int rightX = controller.get_analog(pros::E_CONTROLLER_ANALOG_RIGHT_X);
        chassis.arcade(leftY, rightX);
        //defining button inputs
        #include <algorithm>  // for std::clamp

        const double MAX_POS   = 900.0;  // degrees at the end of travel (tune this)
        const double MIN_SPEED = 0.1;    // fraction of full speed at the end (0.4 = 40%)

        // in initialize():
        wrist.set_encoder_units(pros::E_MOTOR_ENCODER_DEGREES);
        wrist.set_brake_mode(pros::E_MOTOR_BRAKE_HOLD);
        wrist.tare_position();  // treat the starting position as 0

        // in your control loop:
        double t = std::clamp(wrist.get_position() / MAX_POS, 0.0, 1.0);
        double scale = 0.5 - t * (0.5 - MIN_SPEED);  // 1.0 at start, MIN_SPEED at end

        if (controller.get_digital(pros::E_CONTROLLER_DIGITAL_DOWN)) {
            wrist.move(127 * scale);   // cascade up
        } else if (controller.get_digital(pros::E_CONTROLLER_DIGITAL_B)) {
            wrist.move(-80 * scale);  // cascade down
        } else {
            wrist.brake();
}
        // if (controller.get_digital(pros::E_CONTROLLER_DIGITAL_DOWN)) {
        //     wrist.move(127); // wrist up
        // } else if (controller.get_digital(pros::E_CONTROLLER_DIGITAL_B)) {
        //     wrist.move(-100); // wrist down
        // } else {
        // wrist.brake();
        // }
        //cascade
        if (controller.get_digital(pros::E_CONTROLLER_DIGITAL_L1)) {
            cascades.move(-127); // cascade up
        } else if (controller.get_digital(pros::E_CONTROLLER_DIGITAL_L2)) {
            cascades.move(100); // cascade down
        } else {
        cascades.move(0);
        }
        // intake — toggle on R1, outtake — toggle on R2
        if (controller.get_digital_new_press(pros::E_CONTROLLER_DIGITAL_R1)) {
            intakeOn = !intakeOn;
            intakeOut = false; // turning intake on cancels outtake
        }
        if (controller.get_digital_new_press(pros::E_CONTROLLER_DIGITAL_R2)) {
            intakeOut = !intakeOut;
            intakeOn = false; // turning outtake on cancels intake
        }
        if (intakeOn) {
            intake_and_claw.move(127);
        } else if (intakeOut) {
            intake_and_claw.move(-127);
        } else {
            intake_and_claw.move(0);
        }
    }
}

    
